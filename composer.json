{
    "name": "kamaltur/pos",
    "description": "KAMALTUR POS - travel operations and point-of-sale system",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.1"
    },
    "autoload": {
        "psr-4": {
            "Kamaltur\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/",
            "Kamaltur\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "migrate": "php bin/migrate.php",
        "test": "php tests/smoke.php && vendor/bin/pest",
        "test:unit": "vendor/bin/pest tests/Unit",
        "test:http": "bash tests/http-smoke.sh",
        "build": "npm --prefix frontend run build"
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "require-dev": {
        "pestphp/pest": "^4.7"
    }
}
